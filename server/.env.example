# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swipehire
DB_USER=postgres
DB_PASSWORD=password
# Or use a single connection string:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/swipehire

# Server
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# JWT Secrets — generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Redis
REDIS_URL=redis://localhost:6379

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_UNLIMITED_PRICE_ID=price_...

# LinkedIn OAuth (https://www.linkedin.com/developers/apps)
# Required scopes: openid, profile, email
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/auth/linkedin/callback

# AWS S3 (optional — for avatar/resume uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# OpenAI (optional — for AI career coach feature)
OPENAI_API_KEY=
