# SwipeHire server environment configuration
# Copy to .env and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Database (use either DATABASE_URL or the individual DB_* variables)
# DATABASE_URL=postgres://user:password@host:5432/swipehire
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swipehire
DB_USER=postgres
DB_PASSWORD=change_me

# Redis
REDIS_URL=redis://localhost:6379

# JWT secrets — REQUIRED in production. Generate with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string

# Client URL (used for CORS allowlist + Stripe redirects).
# Comma-separated for multiple allowed origins (e.g. https://app.x.com,https://staging.x.com).
CLIENT_URL=http://localhost:3000

# Setup endpoints (/api/setup/*) require this token via X-Setup-Token header.
# In production this MUST be set or the endpoints return 503.
SETUP_TOKEN=

# Seed a default admin@swipehire.com account on first boot.
# Always seeded in non-production. In production, set to 'true' to seed once.
SEED_DEFAULT_ADMIN=false
DEFAULT_ADMIN_PASSWORD=change_me_after_first_login

# Stripe (optional for dev; required for payment features)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRO_PRICE_ID=price_replace_me
STRIPE_UNLIMITED_PRICE_ID=price_replace_me
