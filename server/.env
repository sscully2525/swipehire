NODE_ENV=production
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swipehire
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_32_CHAR_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_RANDOM_32_CHAR_STRING

# Client URL
CLIENT_URL=http://localhost:3000

# Stripe API Keys (Sign up at https://stripe.com to get these)
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
STRIPE_PRO_PRICE_ID=price_YOUR_PRO_PRICE_ID_HERE
STRIPE_UNLIMITED_PRICE_ID=price_YOUR_UNLIMITED_PRICE_ID_HERE

# Optional: OpenAI for enhanced AI features
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE