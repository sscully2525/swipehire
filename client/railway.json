{
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["nodejs_20", "npm-10_x"]
        },
        "build": {
          "cmds": ["npm install && npm run build"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "npx serve -s dist -l 3000",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}